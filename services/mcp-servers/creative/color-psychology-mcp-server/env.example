# VividWalls Color Psychology MCP Server Configuration
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/vividwalls_color_psychology
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_VISION_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=hd
OPENAI_IMAGE_STYLE=natural
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# MCP Server Configuration
MCP_SERVER_NAME=color-psychology-mcp-server
MCP_SERVER_VERSION=1.0.0
MCP_SERVER_PORT=8080
MCP_SERVER_HOST=localhost

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=logs/color-psychology.log
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5
LOG_CONSOLE_ENABLED=true

# Security Configuration
API_KEY_HEADER=X-API-Key
CORS_ORIGINS=http://localhost:3000,https://vividwalls.com
MAX_REQUEST_SIZE=10485760
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Image Processing Configuration
MAX_IMAGE_SIZE=5242880
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp
IMAGE_COMPRESSION_QUALITY=85
THUMBNAIL_SIZE=256x256

# Color Analysis Configuration
COLOR_PALETTE_SIZE=5
COLOR_EXTRACTION_METHOD=kmeans
COLOR_DISTANCE_METRIC=deltaE
MIN_COLOR_PROMINENCE=0.05

# Recommendation Configuration
MAX_RECOMMENDATIONS=10
MIN_HARMONY_SCORE=0.7
PSYCHOLOGICAL_WEIGHT=0.4
COLOR_HARMONY_WEIGHT=0.6

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Development/Debug Configuration
DEBUG=false
DEVELOPMENT_MODE=false
MOCK_OPENAI_RESPONSES=false

# Feature Flags
ENABLE_COLOR_THEORY_SEARCH=true
ENABLE_ARTWORK_ANALYSIS=true
ENABLE_ROOM_ANALYSIS=true
ENABLE_COMPOSITE_GENERATION=true
ENABLE_PSYCHOLOGICAL_ANALYSIS=true

# Performance Configuration
WORKER_THREADS=4
ASYNC_TIMEOUT=30
BATCH_SIZE=10

# Storage Configuration
STORAGE_TYPE=local
STORAGE_PATH=./storage
STORAGE_BUCKET=vividwalls-color-psychology

# Monitoring Configuration
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# NO HUMANS OR ANIMALS Safety Configuration
ENFORCE_NO_LIVING_BEINGS=true
SAFETY_CHECK_ENABLED=true
SAFETY_VIOLATION_ACTION=reject 