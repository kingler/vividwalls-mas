{
  "name": "pictorem-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Pictorem print-on-demand API integration with browser automation",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "setup-browsers": "playwright install chromium",
    "setup-all": "npm install && npm run setup-browsers && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pictorem",
    "print-on-demand",
    "canvas",
    "fulfillment",
    "browser-automation",
    "ai-agents"
  ],
  "author": "VividWalls",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.4",
    "axios": "^1.7.0",
    "form-data": "^4.0.0",
    "playwright": "^1.40.0",
    "puppeteer": "^21.0.0",
    "sharp": "^0.33.0",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "axios-mock-adapter": "^1.22.0",
    "@types/cheerio": "^0.22.0",
    "@playwright/test": "^1.40.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
} 