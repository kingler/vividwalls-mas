{
  "name": "wordpress-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for WordPress management with Art of Space blog content marketing automation",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "clean": "rm -rf build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wordpress",
    "cms",
    "blog",
    "content-management",
    "art-of-space",
    "vividwalls",
    "marketing-automation",
    "gutenberg",
    "seo"
  ],
  "author": "VividWalls",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.1",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0-rc.12",
    "crypto": "^1.0.1",
    "form-data": "^4.0.0",
    "jsdom": "^24.0.0",
    "node-html-parser": "^6.1.0",
    "sharp": "^0.33.0",
    "slug": "^8.2.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.0",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.0",
    "@types/node": "^22.10.10",
    "@types/slug": "^5.0.9",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "build"
  ],
  "bin": {
    "wordpress-mcp-server": "./build/index.js"
  }
}
