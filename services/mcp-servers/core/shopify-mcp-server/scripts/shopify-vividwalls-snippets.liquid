{% comment %}
  VividWalls CopilotKit Liquid Snippets
  These snippets can be included in Shopify theme templates for enhanced functionality
{% endcomment %}

{% comment %}
  Product Page Enhanced Integration
  Include this in product.liquid or product-form.liquid
{% endcomment %}
{% if template contains 'product' %}
<script>
  window.VividWallsProductData = {
    id: {{ product.id }},
    title: {{ product.title | json }},
    handle: {{ product.handle | json }},
    vendor: {{ product.vendor | json }},
    type: {{ product.type | json }},
    tags: {{ product.tags | json }},
    price: {{ product.price | money_without_currency | remove: ',' }},
    compare_at_price: {{ product.compare_at_price | money_without_currency | remove: ',' }},
    available: {{ product.available }},
    description: {{ product.description | strip_html | strip | json }},
    images: [
      {% for image in product.images %}
        {
          url: {{ image.url | json }},
          alt: {{ image.alt | json }},
          width: {{ image.width }},
          height: {{ image.height }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ],
    variants: [
      {% for variant in product.variants %}
        {
          id: {{ variant.id }},
          title: {{ variant.title | json }},
          price: {{ variant.price | money_without_currency | remove: ',' }},
          compare_at_price: {{ variant.compare_at_price | money_without_currency | remove: ',' }},
          available: {{ variant.available }},
          sku: {{ variant.sku | json }},
          weight: {{ variant.weight }},
          option1: {{ variant.option1 | json }},
          option2: {{ variant.option2 | json }},
          option3: {{ variant.option3 | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ],
    options: [
      {% for option in product.options_with_values %}
        {
          name: {{ option.name | json }},
          values: {{ option.values | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ],
    metafields: {
      {% if product.metafields.vividwalls.art_style %}
        art_style: {{ product.metafields.vividwalls.art_style | json }},
      {% endif %}
      {% if product.metafields.vividwalls.room_type %}
        room_type: {{ product.metafields.vividwalls.room_type | json }},
      {% endif %}
      {% if product.metafields.vividwalls.color_palette %}
        color_palette: {{ product.metafields.vividwalls.color_palette | json }},
      {% endif %}
      {% if product.metafields.vividwalls.dimensions %}
        dimensions: {{ product.metafields.vividwalls.dimensions | json }},
      {% endif %}
      {% if product.metafields.vividwalls.limited_edition %}
        limited_edition: {{ product.metafields.vividwalls.limited_edition }},
      {% endif %}
      {% if product.metafields.vividwalls.edition_number %}
        edition_number: {{ product.metafields.vividwalls.edition_number }},
      {% endif %}
      {% if product.metafields.vividwalls.total_editions %}
        total_editions: {{ product.metafields.vividwalls.total_editions }},
      {% endif %}
      {% if product.metafields.vividwalls.artist_info %}
        artist_info: {{ product.metafields.vividwalls.artist_info | json }},
      {% endif %}
      {% if product.metafields.vividwalls.framing_options %}
        framing_options: {{ product.metafields.vividwalls.framing_options | json }},
      {% endif %}
      {% if product.metafields.vividwalls.material_info %}
        material_info: {{ product.metafields.vividwalls.material_info | json }}
      {% endif %}
    }
  };

  // Enhanced product-specific chat suggestions
  window.VividWallsProductSuggestions = [
    "Tell me more about this artwork",
    "What rooms would this piece work well in?",
    "What size should I choose for my space?",
    "Are there any similar pieces you'd recommend?",
    {% if product.metafields.vividwalls.limited_edition %}
    "How many editions are left?",
    {% endif %}
    "What framing options work best with this piece?",
    "Can you help me visualize this in my room?"
  ];
</script>
{% endif %}

{% comment %}
  Collection Page Enhanced Integration
  Include this in collection.liquid
{% endcomment %}
{% if template contains 'collection' %}
<script>
  window.VividWallsCollectionData = {
    id: {{ collection.id }},
    title: {{ collection.title | json }},
    handle: {{ collection.handle | json }},
    description: {{ collection.description | strip_html | strip | json }},
    products_count: {{ collection.products_count }},
    image: {% if collection.image %}{{ collection.image.url | json }}{% else %}null{% endif %},
    metafields: {
      {% if collection.metafields.vividwalls.style_category %}
        style_category: {{ collection.metafields.vividwalls.style_category | json }},
      {% endif %}
      {% if collection.metafields.vividwalls.color_themes %}
        color_themes: {{ collection.metafields.vividwalls.color_themes | json }},
      {% endif %}
      {% if collection.metafields.vividwalls.room_suggestions %}
        room_suggestions: {{ collection.metafields.vividwalls.room_suggestions | json }},
      {% endif %}
      {% if collection.metafields.vividwalls.price_range %}
        price_range: {{ collection.metafields.vividwalls.price_range | json }}
      {% endif %}
    }
  };

  // Collection-specific chat suggestions
  window.VividWallsCollectionSuggestions = [
    "Show me the most popular pieces from this collection",
    "What artwork would work in a modern living room?",
    "I'm looking for something under $200",
    "Find me pieces with warm color tones",
    "What's new in this collection?",
    "Help me choose art for a small apartment",
    "Show me limited edition pieces"
  ];
</script>
{% endif %}

{% comment %}
  Cart Page Integration
  Include this in cart.liquid
{% endcomment %}
{% if template contains 'cart' %}
<script>
  window.VividWallsCartData = {
    item_count: {{ cart.item_count }},
    total_price: {{ cart.total_price | money_without_currency | remove: ',' }},
    items: [
      {% for item in cart.items %}
        {
          id: {{ item.id }},
          product_id: {{ item.product_id }},
          variant_id: {{ item.variant_id }},
          title: {{ item.product.title | json }},
          variant_title: {{ item.variant.title | json }},
          price: {{ item.price | money_without_currency | remove: ',' }},
          quantity: {{ item.quantity }},
          line_price: {{ item.line_price | money_without_currency | remove: ',' }},
          image: {{ item.image.url | json }},
          handle: {{ item.product.handle | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  };

  // Cart-specific chat suggestions
  window.VividWallsCartSuggestions = [
    "Are these pieces from my cart compatible for the same room?",
    "What other artwork would complement my selections?",
    "Help me with sizing for these pieces",
    "Do you have any discount codes available?",
    "When will my order ship?",
    "Can you help me create a gallery wall with these pieces?"
  ];
</script>
{% endif %}

{% comment %}
  Customer Account Integration
  Include this in account templates
{% endcomment %}
{% if customer %}
<script>
  window.VividWallsCustomerData = {
    id: {{ customer.id }},
    email: {{ customer.email | json }},
    first_name: {{ customer.first_name | json }},
    last_name: {{ customer.last_name | json }},
    orders_count: {{ customer.orders_count }},
    total_spent: {{ customer.total_spent | money_without_currency | remove: ',' }},
    tags: {{ customer.tags | json }},
    accepts_marketing: {{ customer.accepts_marketing }},
    default_address: {% if customer.default_address %}{
      city: {{ customer.default_address.city | json }},
      province: {{ customer.default_address.province | json }},
      country: {{ customer.default_address.country | json }}
    }{% else %}null{% endif %}
  };
</script>
{% endif %}

{% comment %}
  Search Page Integration
  Include this in search.liquid
{% endcomment %}
{% if template contains 'search' %}
<script>
  window.VividWallsSearchData = {
    terms: {{ search.terms | json }},
    performed: {{ search.performed }},
    results_count: {{ search.results_count }},
    results: [
      {% for item in search.results %}
        {% if item.object_type == 'product' %}
        {
          type: 'product',
          id: {{ item.id }},
          title: {{ item.title | json }},
          handle: {{ item.handle | json }},
          price: {{ item.price | money_without_currency | remove: ',' }},
          image: {% if item.featured_image %}{{ item.featured_image.url | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
        {% endif %}
      {% endfor %}
    ]
  };

  // Search-specific chat suggestions
  window.VividWallsSearchSuggestions = [
    "Help me refine my search",
    "Show me similar artwork",
    "What's the difference between these pieces?",
    "Filter results by price range",
    "Find artwork for specific room types"
  ];
</script>
{% endif %}

{% comment %}
  AI Assistant Context Injection
  This should be included on all pages to provide context to the AI
{% endcomment %}
<script>
  // Global VividWalls context
  window.VividWallsContext = {
    shop: {
      name: {{ shop.name | json }},
      domain: {{ shop.domain | json }},
      currency: {{ shop.currency | json }},
      money_format: {{ shop.money_format | json }}
    },
    page: {
      template: {{ template | json }},
      url: window.location.href,
      title: document.title
    },
    timestamp: new Date().toISOString(),
    session_id: sessionStorage.getItem('vividwalls_session_id')
  };

  // Merge page-specific data
  if (typeof window.VividWallsProductData !== 'undefined') {
    window.VividWallsContext.product = window.VividWallsProductData;
    window.VividWallsContext.suggestions = window.VividWallsProductSuggestions;
  }
  
  if (typeof window.VividWallsCollectionData !== 'undefined') {
    window.VividWallsContext.collection = window.VividWallsCollectionData;
    window.VividWallsContext.suggestions = window.VividWallsCollectionSuggestions;
  }
  
  if (typeof window.VividWallsCartData !== 'undefined') {
    window.VividWallsContext.cart = window.VividWallsCartData;
    window.VividWallsContext.suggestions = window.VividWallsCartSuggestions;
  }
  
  if (typeof window.VividWallsCustomerData !== 'undefined') {
    window.VividWallsContext.customer = window.VividWallsCustomerData;
  }
  
  if (typeof window.VividWallsSearchData !== 'undefined') {
    window.VividWallsContext.search = window.VividWallsSearchData;
    window.VividWallsContext.suggestions = window.VividWallsSearchSuggestions;
  }
</script>

{% comment %}
  Performance optimization: Preload critical resources
{% endcomment %}
{% unless customer %}
<link rel="preload" href="https://unpkg.com/react@18/umd/react.production.min.js" as="script">
<link rel="preload" href="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" as="script">
{% endunless %}

{% comment %}
  Analytics tracking for VividWalls interactions
{% endcomment %}
<script>
  // Track VividWalls CopilotKit usage
  document.addEventListener('DOMContentLoaded', function() {
    // Track when chat is opened
    document.addEventListener('click', function(e) {
      if (e.target.classList.contains('copilot-fab')) {
        if (typeof gtag !== 'undefined') {
          gtag('event', 'vividwalls_chat_opened', {
            page_template: {{ template | json }},
            page_url: window.location.href
          });
        }
      }
    });
  });
</script>