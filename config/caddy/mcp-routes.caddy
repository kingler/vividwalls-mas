# MCP Server Routes for VividWalls
# This file configures reverse proxy routes for all MCP servers

# Creative Services
handle_path /mcp/color-psychology* {
    reverse_proxy localhost:8001 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Analytics Services
