# Neo4j Configuration - Authentication disabled for local development
NEO4J_AUTH=none
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# ngrok Configuration
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_AUTHTOKEN_TELEGRAM=your_telegram_ngrok_authtoken_here
NGROK_AUTHTOKEN_WHATSAPP=your_whatsapp_ngrok_authtoken_here
NGROK_AUTHTOKEN_FACEBOOK=your_facebook_ngrok_authtoken_here
NGROK_AUTHTOKEN_INSTAGRAM=your_instagram_ngrok_authtoken_here

# N8N Configuration
POSTGRES_USER=root
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
POSTGRES_DB=n8n
N8N_ENCRYPTION_KEY=your_n8n_encryption_key_here
N8N_USER_MANAGEMENT_JWT_SECRET=your_n8n_jwt_secret_here
N8N_API_KEY=your_n8n_api_key_here

# Webhook Configuration
WEBHOOK_URL=https://n8n.vividmas.ngrok.app:5678
TELEGRAM_WEBHOOK_URL=https://telegram.vividmas.ngrok.app:5678
WHATSAPP_WEBHOOK_URL=https://whatsapp.vividmas.ngrok.app:5678
FACEBOOK_WEBHOOK_URL=https://facebook.vividmas.ngrok.app:5678
INSTAGRAM_WEBHOOK_URL=https://instagram.vividmas.ngrok.app:5678

# Search & Research APIs
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_BASE_URL=https://api.tavily.com/search
TAVILY_EXTRACT_URL=https://api.tavily.com/extract
SERPAPI_KEY=your_serpapi_key_here
DATAFORSEO_USERNAME=your_email@example.com
DATAFORSEO_PASSWORD=your_dataforseo_password_here

# Google Cloud Platform
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_CALENDAR_ID=your_google_calendar_id_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Meta Platform (Facebook/Instagram/WhatsApp)
# Note: App Token expires in ~3 months (around May 22, 2025)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_APP_TOKEN=your_meta_app_token_here
META_APP_TOKEN_EXPIRES=2025-05-22

# WhatsApp Business
WHATSAPP_BASE_URL=https://graph.facebook.com/v22.0/your_phone_id/messages
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_PHONE_ID=your_whatsapp_phone_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_APP_ID=your_whatsapp_app_id_here
WHATSAPP_APP_SECRET=your_whatsapp_app_secret_here

# Instagram
INSTAGRAM_APP_NAME=vivid_mas-IG
INSTAGRAM_APP_ID=your_instagram_app_id_here
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here

# Meta Marketing API
META_MARKETING_TOKEN=your_meta_marketing_token_here

# AI APIs
OPEN_ROUTER_KEY=your_open_router_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Supabase Configuration
SUPABASE_DB_HOST=supabase-db
SUPABASE_DB_PORT=5432
SUPABASE_DB=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-super-secret-supabase-db-password
SUPABASE_PROJECT_ID=Default
SUPABASE_AUTH_PASSWORD=your-super-secret-auth-password
SUPABASE_ADMIN_PASSWORD=your-super-secret-admin-password
POSTGRES_MULTIPLE_DATABASES=postgres,5crse,mabos,vividwalls_mas

# Supabase API Configuration
JWT_SECRET=your_jwt_secret_here
ANON_KEY=your_anon_key_here
SERVICE_ROLE_KEY=your_service_role_key_here

# Supabase Dashboard
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=secure-dashboard-password

# Supabase API URLs
SUPABASE_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
SUPABASE_REST_URL=http://localhost:8000/rest/v1
SITE_URL=http://localhost:8000

# Studio Configuration
STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project
STUDIO_PG_META_URL=http://meta:8080

# Email Configuration
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
SMTP_SENDER_NAME=Your Service

# Feature Flags
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
DISABLE_SIGNUP=false

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_TTL=300
REDIS_PREFIX=vw_cache:

# Neo4j Configuration
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Cache Settings
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_PREFIX=vw_cache:

# Monitoring
ENABLE_MONITORING=true
ALERT_WEBHOOK_URL=https://your-webhook-url/alerts

# Supabase Additional Configuration
SUPABASE_JWT_SECRET=${JWT_SECRET}
REALTIME_SECRET_KEY_BASE=your-super-secret-realtime-key-base
API_EXTERNAL_URL=http://auth:9999
