    "facebook-ads-mcp": {
      "command": "python",
      "args": [
        "/Users/kinglerbercy/Projects/vivid_mas/services/mcp-servers/social-media/facebook-ads-mcp-server/server.py"
      ],
      "env": {
        "FACEBOOK_ACCESS_TOKEN": "${FACEBOOK_ACCESS_TOKEN}",
