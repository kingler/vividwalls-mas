{
  "mcpServers": {
    "seo-research-mcp": {
      "command": "node",
      "args": [
        "/Users/kinglerbercy/Projects/vivid_mas/services/mcp-servers/research/seo-research-mcp/dist/index.js"
      ],
      "env": {
        "DATAFORSEO_API_KEY": "${DATAFORSEO_API_KEY}",
        "BRAVE_API_KEY": "${BRAVE_API_KEY}",
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}",
        "TAVILY_API_KEY": "${TAVILY_API_KEY}",
        "SERPAPI_KEY": "${SERPAPI_KEY}",
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "NODE_ENV": "production"
      },
      "description": "Multi-source SEO research and analysis tools for VividWalls Marketing Research Agent",
      "notes": "Provides comprehensive SEO intelligence including keyword research, backlink analysis, and SERP data"
    },
    "tavily-mcp": {
      "command": "npx",
      "args": [
        "-y", 
        "tavily-mcp@0.2.1"
      ],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      },
      "description": "Real-time web search and content extraction tools for market intelligence",
      "notes": "Provides tavily-search, tavily-extract, tavily-map, and tavily-crawl capabilities"
    },
    "pinterest-mcp": {
      "command": "node",
      "args": [
        "/Users/kinglerbercy/Projects/vivid_mas/services/mcp-servers/social-media/pinterest-mcp-server/server.py"
      ],
      "env": {
        "PINTEREST_ACCESS_TOKEN": "${PINTEREST_ACCESS_TOKEN}",
        "PINTEREST_CLIENT_ID": "${PINTEREST_CLIENT_ID}",
        "PINTEREST_CLIENT_SECRET": "${PINTEREST_CLIENT_SECRET}"
      },
      "description": "Pinterest marketing and trend analysis tools",
      "notes": "Visual trend analysis and audience insights for art market research"
    },
    "email-marketing-mcp": {
      "command": "python",
      "args": [
        "/Users/kinglerbercy/Projects/vivid_mas/services/mcp-servers/core/email-marketing-mcp-server/server.py"
      ],
      "env": {
        "SENDGRID_API_KEY": "${SENDGRID_API_KEY}",
        "MAILCHIMP_API_KEY": "${MAILCHIMP_API_KEY}"
