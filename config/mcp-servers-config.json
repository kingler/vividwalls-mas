      "description": "Shopify store management and customer data tools",
      "notes": "Complete e-commerce operations for VividWalls store"
    },
    "pictorem-mcp": {
      "command": "node",
      "args": [
        "/Users/kinglerbercy/Projects/vivid_mas/services/mcp-servers/creative/pictorem-mcp-server/dist/index.js"
